import numpy as np

class Capa:
    def __init__(self, entradas, neuronas, activacion, bias=False):
        self.neuronas = neuronas
        self.activacion = activacion
        self.bias = bias

        if bias:
            self.pesos = np.random.rand(entradas + 1, neuronas)
        else:
            self.pesos = np.random.rand(entradas, neuronas)

    def feed_forward(self, X):
        self.entrada = X
        N = X @ self.pesos
        self.N = N
        Y = self.activacion(N)
        return Y


def ReLu(x):
    return np.maximum(0, x)


X = np.array([[1, 2, 3],[4, 5, 6]])

W = np.array([[0,    0,   0.1, 0.2],
              [0.3, -1,   0.4, 0.5],
              [1,   0.6,  0.7, 0.8]])

capa1 = Capa(entradas=3, neuronas=4, activacion=ReLu, bias=False)

capa1.entrada = X
capa1.pesos = W 
resultado = capa1.feed_forward(X)

print("X:")
print(capa1.entrada)
print("W:")
print(capa1.pesos)

print("\nMultiplicacion N = X @ pesos:")
print(capa1.N)

print("\nResultado despues de ReLu:")
print(resultado)
